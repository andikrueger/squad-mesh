{
  "name": "squad-mesh",
  "version": "0.1.0",
  "description": "Multi-squad mesh orchestration extension for Squad SDK — cross-squad discovery, steering, visibility, and knowledge propagation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "squad-mesh": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test:integration": "npx tsx --test packages/squad-mesh/tests/integration/*.test.ts",
    "test:integration": "npx tsx --test packages/squad-mesh/tests/integration/discovery.test.ts",
    "test:integration": "npx tsx --test packages/squad-mesh/tests/integration/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@bradygaster/squad-sdk": ">=0.8.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "rimraf": "^6.0.0"
  },
  "keywords": [
    "squad",
    "mesh",
    "multi-squad",
    "orchestration",
    "copilot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/squad-mesh"
  }
}
